# ── AI Provider (NVIDIA, OpenAI-compatible) ────────────────────────────────
# Leave NVIDIA_API_KEY unset to run with the built-in MockProvider (no cost,
# fully functional for local dev/demo). Get a real key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# ── GitHub project discovery ────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=

# ── Google web search (optional) ────────────────────────────────────────────
# Used only when a visitor enables "Google" in the chat input's source picker.
# Leave unset to have Google search silently return no results.
# API key: console.cloud.google.com → enable "Custom Search API" → Credentials
# Engine ID: programmablesearchengine.google.com → create a search engine
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── Contact form webhook ────────────────────────────────────────────────────
# Any URL that accepts a JSON POST (e.g. a Slack incoming webhook, a Zapier
# catch hook, a custom endpoint). Left empty, submissions are logged only.
CONTACT_WEBHOOK_URL=

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
